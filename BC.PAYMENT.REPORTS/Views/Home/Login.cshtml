@{
    ViewData["Title"] = "Login";
}

<style>
    body {
        margin: 0;
        background: #f5f7fa;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        color: #333;
        height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .login-page {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        min-height: calc(100vh - 100px); /* Adjust for layout header/footer */
        padding: 20px;
    }
    .login-box {
        background: #ffffff;
        border-radius: 16px;
        padding: 40px;
        max-width: 400px;
        width: 100%;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
        color: #333;
    }

    .login-box h2 {
        text-align: center;
        margin-bottom: 30px;
        font-weight: 600;
        color: #007acc;
    }

    .form-control {
        background: #fff;
        border: 1px solid #ccc;
        color: #333;
    }

    .form-control:focus {
        border-color: #007acc;
        box-shadow: 0 0 0 2px rgba(0, 122, 204, 0.2);
    }

    .btn-login {
        background: #007acc;
        color: #fff;
    }

    .btn-login:hover {
        background: #005f99;
    }

</style>
<div class="login-page">
    <div class="login-box">
        <h2>Login</h2>
        <form id="loginForm">
            <div class="mb-3">
                <label for="username" class="form-label">Username</label>
                <input class="form-control" id="username" required />
            </div>

            <div class="mb-3">
                <label for="password" class="form-label">Password</label>
                <input class="form-control" id="password" type="password" required />
            </div>

            <div class="mb-3">
                <label for="companyCode" class="form-label">Company Code</label>
                <input class="form-control" id="companyCode" required />
            </div>

            <div class="mb-3">
                <label for="appCode" class="form-label">App Code</label>
                <input class="form-control" id="appCode" required />
            </div>

            <div class="mb-3">
                <label for="dbCode" class="form-label">DB Code</label>
                <input class="form-control" id="dbCode" required />
            </div>

            <div class="error-msg" id="errorMessage"></div>

            <button type="submit" class="btn btn-login">Login</button>
        </form>
    </div>
</div>
@section Scripts {
    <script>
        document.getElementById("loginForm").addEventListener("submit", async function (e) {
            e.preventDefault();

            const payload = {
                username: document.getElementById("username").value,
                password: document.getElementById("password").value,
                companyCode: document.getElementById("companyCode").value,
                appCode: document.getElementById("appCode").value,
                dbCode: document.getElementById("dbCode").value,
            };

            const response = await fetch("/credentials", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(payload)
            });

            const result = await response.json();

            if (result.success) {
                // Redirect or store token
                window.location.href = "/home/designer";
            } else {
                document.getElementById("errorMessage").innerText = result.message;
            }
        });
    </script>
}
